# MySQL 8.0 Configuration File
# Generated by mysql_silent_install.sh (rendered from mysql_silent.cnf)
# see references/mysql-deploy-guide.md

[mysqld]
# 基础配置
user                                  = mysql
port                                  = ${PORT_NUM}
basedir                               = ${INSTALL_PATH}
datadir                               = ${DATA_PATH}
socket                                = ${SOCKET_PATH}
pid-file                              = ${PID_FILE_PATH}
log-error                             = ${LOG_ERROR_PATH}
server-id                             = ${SERVER_ID}

# 字符集与排序规则
character-set-server                  = ${CHARACTER_SET_SERVER}
collation-server                      = ${COLLATION_SERVER}

# 存储引擎
default-storage-engine                = ${DEFAULT_STORAGE_ENGINE}

# 连接数
max_connections                       = ${MAX_CONNECTIONS}

# InnoDB 配置
innodb_buffer_pool_size               = ${INNODB_BUFFER_POOL_SIZE}
innodb_log_file_size                  = 256M
innodb_log_buffer_size                = 16M
innodb_flush_log_at_trx_commit        = 1
innodb_file_per_table                 = 1

# 日志配置
log-bin                               = mysql-bin
binlog_format                         = ROW
expire_logs_days                      = 7
slow_query_log                        = 1
long_query_time                       = 2

# 安全配置
local-infile                          = 0
symbolic-links                        = 0

[client]
port                                  = ${PORT_NUM}
socket                                = ${SOCKET_PATH}
default-character-set                 = ${CHARACTER_SET_SERVER}

[mysql]
default-character-set                 = ${CHARACTER_SET_SERVER}
